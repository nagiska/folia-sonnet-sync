# Android Capacitor WebView build configuration.
# Public build-time config: do not store passwords or tokens in VITE_ variables.
# `extension` = use the bridge bundled in the app (src/nativeBridge) instead of a remote API server.
VITE_NETEASE_API_BASE=extension
VITE_QQ_API_BASE=extension
VITE_KUGOU_API_BASE=extension
